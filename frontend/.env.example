# Copy to .env. Only NEXT_PUBLIC_ values reach the browser, so never put a secret in one.

# Address of the FastAPI backend, used by the Next.js proxy for /api/v1.
BACKEND_URL=http://127.0.0.1:8000

# Shows demo role cards and prefills demo sign-in. Must be false anywhere real people sign in.
# NEXT_PUBLIC_ values are copied into the browser code when the frontend is built: after changing one, restart
# `npm run dev`, or run `npm run build` again before `npm start`.
NEXT_PUBLIC_DEMO_MODE=false
# Demo environments only, and never a real password: anything here is readable by every visitor. Leave empty for
# real use. Admin credentials belong only in backend/.env (ADMIN_EMAIL / ADMIN_PASSWORD).
NEXT_PUBLIC_DEMO_PASSWORD=

# The web server (server.mjs) reads these from the shell environment, not from this file:
# PORT=3000        port to listen on
# HOST=            interface to bind; empty means all interfaces
