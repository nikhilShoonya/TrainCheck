# Copy to .env. Only NEXT_PUBLIC_ values reach the browser, so never put a secret in one.

# Address of the FastAPI backend, used by the Next.js proxy for /api/v1.
BACKEND_URL=http://127.0.0.1:8000

# Shows demo role cards and prefills demo sign-in. Must be false anywhere real people sign in.
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_DEMO_PASSWORD=
