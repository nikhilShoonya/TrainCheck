# Copy to .env and fill in. Never commit .env.

APP_ENV=development

# Neon: pooled connection string (hostname contains "-pooler"). Used by the API and scheduler.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/traincheck?sslmode=require
# Neon: direct connection string (no "-pooler"). Used only by Alembic migrations.
DATABASE_URL_DIRECT=postgresql+psycopg://USER:PASSWORD@ep-example.region.aws.neon.tech/traincheck?sslmode=require
# Separate database for automated tests, for example a Neon branch or local PostgreSQL. Its contents are erased by the tests.
TEST_DATABASE_URL=

# Frontend origin allowed to call the API directly. The frontend normally proxies /api/v1.
CORS_ORIGINS=http://localhost:3000

# Sessions. These values are proposals pending Finvasia Security approval.
SESSION_COOKIE_SECURE=false
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12

# Login rate limit
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15

# Private storage for uploads and generated exports. Must not be publicly served.
FILE_STORAGE_DIR=./var/files
MAX_UPLOAD_BYTES=5242880

# Organisation timezone used for scheduling when a calendar does not set one (provisional, OD-BRD-004)
DEFAULT_TIMEZONE=Asia/Kolkata

# Run reminders, escalations and scheduled reports inside the API process
SCHEDULER_ENABLED=true

# ---------- Scope and policy ----------
# Level 3 Behaviour is outside the approved scope. false: no new follow-up cycles, behaviour tasks,
# reminders or submissions; existing behaviour records stay readable. true restores the legacy workflow.
BEHAVIOUR_ENABLED=false
# Business decision pending: does PARTIAL attendance count as training completion? Present always does.
COMPLETION_ALLOWS_PARTIAL_ATTENDANCE=false

# ---------- Demo environments only ----------
# true shows a working "Reset demo data" button on the sign-in page (with NEXT_PUBLIC_DEMO_MODE=true in the
# frontend). It erases EVERY table and reloads the synthetic data from app/seed.py, and anyone who can reach
# the sign-in page can press it. Never enable it where real data lives. Always refused when APP_ENV=production.
DEMO_RESET_ENABLED=false

# ---------- Rate limiting and client identity ----------
# Signed-in users are limited per account; everyone else per verified client IP.
RATE_LIMIT_ENABLED=true
# memory   = one backend instance.
# database = several backend instances share counters in PostgreSQL (run `alembic upgrade head` first).
RATE_LIMIT_STORE=memory
RATE_LIMIT_USER_PER_MINUTE=600
RATE_LIMIT_ANONYMOUS_PER_MINUTE=600
RATE_LIMIT_IMPORT_PER_MINUTE=20
RATE_LIMIT_EXPORT_PER_MINUTE=30
RATE_LIMIT_BULK_PER_MINUTE=30
RATE_LIMIT_REPORT_PER_MINUTE=120

# Addresses (or CIDR ranges) of every proxy hop in front of this API whose X-Forwarded-For may be believed:
# the Next.js server, plus any load balancer in front of it. Comma separated. Never "*".
# Empty = trust no forwarded header; every caller is identified by its own connection address.
# Example when Next.js runs on the same host as the API:   TRUSTED_PROXIES=127.0.0.1,::1
# Run uvicorn with --no-proxy-headers so this list is the only one that decides (see ADR-0002).
TRUSTED_PROXIES=
