# Copy to .env and fill in. Never commit .env.

APP_ENV=development

# Neon: pooled connection string (hostname contains "-pooler"). Used by the API and scheduler.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/traincheck?sslmode=require
# Neon: direct connection string (no "-pooler"). Used only by Alembic migrations.
DATABASE_URL_DIRECT=postgresql+psycopg://USER:PASSWORD@ep-example.region.aws.neon.tech/traincheck?sslmode=require
# Separate database for automated tests, for example a Neon branch or local PostgreSQL. Its contents are erased by the tests.
TEST_DATABASE_URL=

# Frontend origin allowed to call the API directly. The frontend normally proxies /api/v1.
CORS_ORIGINS=http://localhost:3000

# Sessions. These values are proposals pending Finvasia Security approval.
SESSION_COOKIE_SECURE=false
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12

# Login rate limit
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15

# Private storage for uploads and generated exports. Must not be publicly served.
FILE_STORAGE_DIR=./var/files
MAX_UPLOAD_BYTES=5242880

# Organisation timezone used for scheduling when a calendar does not set one (provisional, OD-BRD-004)
DEFAULT_TIMEZONE=Asia/Kolkata

# Run reminders, escalations and scheduled reports inside the API process
SCHEDULER_ENABLED=true
